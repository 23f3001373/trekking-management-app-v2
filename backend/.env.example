# ============================================================
# .env.example — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# Then load it automatically via python-dotenv (run.py does this)
# or via your shell: `export $(cat .env | xargs)`

# ---- Flask ----
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
FLASK_PORT=5000

# ---- Admin Seed (first-boot only) ----
ADMIN_SEED_EMAIL=admin@trekapp.com
ADMIN_SEED_PASSWORD=Admin@SecurePass123

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Email / SMTP ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SENDER=noreply@trekapp.com

# ---- CORS (comma-separated origins) ----
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
